<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.web>
    <!-- Allow ':' in URL paths (required for Django-signed encrypted chart IDs).
         The default IIS invalid-char list includes ':' which blocks signed tokens.
         We keep all other dangerous chars restricted. -->
    <httpRuntime requestPathInvalidCharacters="&lt;,&gt;,*,%,&amp;,\,?" />
  </system.web>
  <system.webServer>
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="FastCgiModule"
           scriptProcessor="C:\reactjs\react-django-project\backend\venv\Scripts\python.exe|C:\reactjs\react-django-project\backend\venv\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified" />
    </handlers>
    <fastCgi>
      <application fullPath="C:\reactjs\react-django-project\backend\venv\Scripts\python.exe"
                   arguments="C:\reactjs\react-django-project\backend\venv\Lib\site-packages\wfastcgi.py"
                   signalBeforeTerminateSeconds="30">
        <environmentVariables>
          <environmentVariable name="DJANGO_SETTINGS_MODULE" value="backend.settings" />
          <environmentVariable name="PYTHONPATH" value="C:\reactjs\react-django-project\backend" />
        </environmentVariables>
      </application>
    </fastCgi>
  </system.webServer>
</configuration>
